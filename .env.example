# brAInfection V2 — Environment Variables
# Copy this file to .env and edit the values.

# Admin authentication (V1 compatibility — replaced by login in Phase 10)
ADMIN_TOKEN=change-this-to-a-long-random-string

# Database
DATABASE_URL=sqlite:///./data/brAInfection.db

# Secret key for session tokens
SECRET_KEY=change-this-to-a-random-secret-key

# Environment: dev | production
ENV=dev

# Session lifetime in minutes (default 30)
SESSION_LIFETIME_MINUTES=30

# Data retention in days (default 30)
RETENTION_DAYS=30

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
